# Run pnpm run setup to create a local configuration and program identity.
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=.data
PAYMENT_BACKEND=solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_ISSUER_KEYPAIR=.data/issuer.json
# 32 random bytes in base64. Back up separately from the database.
KEY_VAULT_MASTER_KEY=
# mock is opt-in, only available on a loopback origin outside production.
LOCAL_DEMO=0
