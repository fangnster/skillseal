# Public domain pointing to the selected existing Alibaba Cloud server.
SKILLSEAL_DOMAIN=skills.example.com
# Public creator signing address generated in /creators (not its private identity).
ADMIN_WALLET=REPLACE_WITH_REVIEWER_PUBLIC_ADDRESS
# Catalog mode is usable without Solana funding or a deployed program.
PAYMENT_BACKEND=disabled
MODERATION_REQUIRED=1
# Leave checkout disabled until public Devnet acceptance passes.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
# Comma-separated onboarded creator public wallets; required for hosted Devnet.
PUBLISHER_ALLOWLIST=
